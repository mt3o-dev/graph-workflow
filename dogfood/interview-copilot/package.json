{
	"name": "interview-copilot",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check": "pnpm run typecheck",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "vitest run",
		"validate:kb": "tsx scripts/validate-kb.ts",
		"tauri": "tauri",
		"tauri:build": "cross-env TAURI_BUILD=1 tauri build",
		"tauri:dev": "cross-env TAURI_BUILD=1 tauri dev",
		"test:e2e": "tsx e2e/preflight.ts && wdio run e2e/wdio.conf.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "7.0.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.0",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@tauri-apps/cli": "2.11.4",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/svelte": "5.4.2",
		"@types/better-sqlite3": "7.6.13",
		"@wdio/cli": "9.29.1",
		"@wdio/globals": "9.29.1",
		"@wdio/local-runner": "9.29.1",
		"@wdio/mocha-framework": "9.29.1",
		"@wdio/spec-reporter": "9.29.1",
		"better-sqlite3": "12.11.1",
		"cross-env": "10.1.0",
		"gray-matter": "4.0.3",
		"jsdom": "29.1.1",
		"sqlite-vec": "0.1.9",
		"svelte": "5.56.6",
		"svelte-check": "4.7.3",
		"tsx": "4.23.1",
		"typescript": "6.0.3",
		"vite": "8.1.5",
		"vitest": "4.1.10",
		"webdriverio": "9.29.1"
	},
	"dependencies": {
		"@tauri-apps/api": "2.11.1"
	}
}
