{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["bun"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": [".astro/types.d.ts", "**/*", "src/env.gen.d.ts"],
  "exclude": ["dist", "node_modules"]
}
