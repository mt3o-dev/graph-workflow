---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t, resolveLocale } from "../i18n";
import { getCurrentUser } from "../lib/session";

const user = await getCurrentUser(Astro.cookies);
if (!user) return Astro.redirect("/login?next=/admin");

const locale = resolveLocale({
  queryLang: Astro.url.searchParams.get("lang"),
  acceptLanguage: Astro.request.headers.get("accept-language"),
});

if (user.role !== "admin") {
  return new Response(t("admin.forbidden", locale), { status: 403 });
}
---

<BaseLayout title={t("admin.title", locale)} locale={locale}>
  <h1>{t("admin.title", locale)}</h1>
  <p>{t("admin.comingSoon", locale)}</p>
</BaseLayout>
