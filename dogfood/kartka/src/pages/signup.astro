---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t, resolveLocale } from "../i18n";
import { getCurrentUser } from "../lib/session";

const user = await getCurrentUser(Astro.cookies);
if (user) return Astro.redirect("/sets");

const locale = resolveLocale({
  queryLang: Astro.url.searchParams.get("lang"),
  acceptLanguage: Astro.request.headers.get("accept-language"),
});
const error = Astro.url.searchParams.get("error");
---

<BaseLayout title={t("auth.signup.title", locale)} locale={locale}>
  <div class="card" style="max-width:420px;margin-inline:auto">
    <h1>{t("auth.signup.title", locale)}</h1>
    {error && <p class="field-error">{t(`auth.error.${error}` as never, locale)}</p>}
    <form method="post" action="/api/auth/signup" class="stack">
      <div class="field">
        <label for="displayName">{t("auth.field.displayName", locale)}</label>
        <input id="displayName" name="displayName" required autocomplete="name" />
      </div>
      <div class="field">
        <label for="email">{t("auth.field.email", locale)}</label>
        <input id="email" name="email" type="email" required autocomplete="email" />
      </div>
      <div class="field">
        <label for="password">{t("auth.field.password", locale)}</label>
        <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" />
      </div>
      <input type="hidden" name="locale" value={locale} />
      <button type="submit" class="btn-primary">{t("auth.signup.submit", locale)}</button>
    </form>
    <p><a href="/login">{t("auth.signup.hasAccount", locale)}</a></p>
  </div>
</BaseLayout>
