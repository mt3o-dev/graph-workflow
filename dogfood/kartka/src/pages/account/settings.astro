---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t, resolveLocale } from "../../i18n";
import { getCurrentUser } from "../../lib/session";
import { ENV } from "../../env";
import { getContainer } from "../../di/container";

const user = await getCurrentUser(Astro.cookies);
if (!user) return Astro.redirect("/login?next=/account/settings");

// Slice 14: self-service only — always the CURRENT authenticated user's own
// id, never a param/query value, so this can't be used to peek at another
// user's bonus total. Computed as a live SUM over confirmed records rather
// than read from a stored counter — see liveStreakBonusRepoPort.ts.
const { liveStreakBonusRepo } = await getContainer();
const streakBonusTotal = await liveStreakBonusRepo.sumConfirmedPointsForUser(user.id);

const locale = resolveLocale({
  queryLang: Astro.url.searchParams.get("lang"),
  acceptLanguage: Astro.request.headers.get("accept-language"),
});

const saved = Astro.url.searchParams.get("saved") === "1";

// Slice 9: the VAPID *public* key is safe to expose to the client — that's
// the entire point of VAPID's public/private split (see .env.schema's
// comment on VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY). Passed via a data
// attribute rather than a template literal so it never needs HTML-escaping.
const vapidPublicKey = ENV.VAPID_PUBLIC_KEY;
const quietHoursEnabled = !!(user.quietHoursStart && user.quietHoursEnd);
---

<BaseLayout title={t("settings.title", locale)} locale={locale}>
  <h1>{t("settings.title", locale)}</h1>

  {
    saved && (
      <p class="empty-state" role="status" aria-live="polite">
        {t("settings.saved", locale)}
      </p>
    )
  }

  <form method="post" action="/api/account/scheduler-preference" class="stack card">
    <h2>{t("settings.scheduler.label", locale)}</h2>

    <div class="field">
      <label class="row">
        <input type="radio" name="schedulerPreference" value="sm2" checked={user.schedulerPreference === "sm2"} />
        <span>{t("settings.scheduler.sm2", locale)}</span>
      </label>
      <p class="empty-state">{t("settings.scheduler.sm2Hint", locale)}</p>
    </div>

    <div class="field">
      <label class="row">
        <input type="radio" name="schedulerPreference" value="fsrs" checked={user.schedulerPreference === "fsrs"} />
        <span>{t("settings.scheduler.fsrs", locale)}</span>
      </label>
      <p class="empty-state">{t("settings.scheduler.fsrsHint", locale)}</p>
    </div>

    <button type="submit" class="btn-primary">{t("common.save", locale)}</button>
  </form>

  <div class="stack card">
    <h2>{t("settings.streakBonus.title", locale)}</h2>
    <p class="empty-state">{t("settings.streakBonus.hint", locale)}</p>
    <p><strong>{t("settings.streakBonus.total", locale, { points: streakBonusTotal })}</strong></p>
  </div>

  <div id="push-reminders" class="stack card" data-vapid-public-key={vapidPublicKey}>
    <h2>{t("settings.reminders.title", locale)}</h2>
    <p class="empty-state">{t("settings.reminders.intro", locale)}</p>
    <p role="status" aria-live="polite" data-push-status></p>
    <button type="button" class="btn-primary" data-push-toggle disabled>
      {t("settings.reminders.enable", locale)}
    </button>
  </div>

  <form method="post" action="/api/account/reading-profile" class="stack card">
    <h2>{t("settings.reading.label", locale)}</h2>
    <p class="empty-state">{t("settings.reading.hint", locale)}</p>

    <div class="field">
      <label>{t("settings.reading.font.label", locale)}</label>
      <label class="row">
        <input type="radio" name="readingFont" value="system" checked={user.readingFont === "system"} />
        <span>{t("settings.reading.font.system", locale)}</span>
      </label>
      <label class="row">
        <input type="radio" name="readingFont" value="opendyslexic" checked={user.readingFont === "opendyslexic"} />
        <span>{t("settings.reading.font.opendyslexic", locale)}</span>
      </label>
    </div>

    <div class="field">
      <label for="textSize">{t("settings.reading.textSize.label", locale)}</label>
      <select id="textSize" name="textSize">
        <option value="normal" selected={user.textSize === "normal"}>{t("settings.reading.textSize.normal", locale)}</option>
        <option value="large" selected={user.textSize === "large"}>{t("settings.reading.textSize.large", locale)}</option>
        <option value="xlarge" selected={user.textSize === "xlarge"}>{t("settings.reading.textSize.xlarge", locale)}</option>
      </select>
    </div>

    <div class="field">
      <label for="lineSpacing">{t("settings.reading.lineSpacing.label", locale)}</label>
      <select id="lineSpacing" name="lineSpacing">
        <option value="normal" selected={user.lineSpacing === "normal"}>{t("settings.reading.lineSpacing.normal", locale)}</option>
        <option value="relaxed" selected={user.lineSpacing === "relaxed"}>{t("settings.reading.lineSpacing.relaxed", locale)}</option>
        <option value="loose" selected={user.lineSpacing === "loose"}>{t("settings.reading.lineSpacing.loose", locale)}</option>
      </select>
    </div>

    <div class="field">
      <label>{t("settings.reading.contrast.label", locale)}</label>
      <label class="row">
        <input type="radio" name="contrast" value="normal" checked={user.contrast === "normal"} />
        <span>{t("settings.reading.contrast.normal", locale)}</span>
      </label>
      <label class="row">
        <input type="radio" name="contrast" value="high" checked={user.contrast === "high"} />
        <span>{t("settings.reading.contrast.high", locale)}</span>
      </label>
    </div>

    <button type="submit" class="btn-primary">{t("common.save", locale)}</button>
  </form>

  <form method="post" action="/api/account/quiet-hours" class="stack card">
    <h2>{t("settings.quietHours.label", locale)}</h2>
    <p class="empty-state">{t("settings.quietHours.hint", locale)}</p>

    <div class="field">
      <label class="row">
        <input type="checkbox" name="quietHoursEnabled" value="1" checked={quietHoursEnabled} id="quiet-hours-enabled" />
        <span>{t("settings.quietHours.enable", locale)}</span>
      </label>
    </div>

    <div class="field row">
      <label>
        {t("settings.quietHours.start", locale)}
        <input type="time" name="quietHoursStart" value={user.quietHoursStart ?? "22:00"} />
      </label>
      <label>
        {t("settings.quietHours.end", locale)}
        <input type="time" name="quietHoursEnd" value={user.quietHoursEnd ?? "07:00"} />
      </label>
    </div>

    <button type="submit" class="btn-primary">{t("common.save", locale)}</button>
  </form>

  <script>
    import { initPushReminders } from "../../client/push/register";
    initPushReminders();
  </script>
</BaseLayout>
