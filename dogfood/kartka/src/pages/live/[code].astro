---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t, resolveLocale } from "../../i18n";
import { getCurrentUser } from "../../lib/session";
import { isValidRoomCode } from "../../core/domain/liveQuiz";
import { ENV } from "../../env";

// Slice 11 (live quiz): the room page — the phone-in-hand shell shared by
// every player, host included. Slice 13 added a SEPARATE dedicated
// big-screen route (./[code]/host.astro) for the host to project; this page
// is unchanged for players and still works exactly as before if the host
// opens it too (e.g. to answer along on their own device). All the
// real-time behavior (question/reveal/scoreboard swaps) comes from
// htmx-ext-ws's `ws-connect`, pointed at the WebSocket sidecar process on its
// own port — see docs/ADR-live-transport.md.
const user = await getCurrentUser(Astro.cookies);
if (!user) return Astro.redirect(`/login?next=${Astro.url.pathname}`);

const locale = resolveLocale({
  queryLang: Astro.url.searchParams.get("lang"),
  acceptLanguage: Astro.request.headers.get("accept-language"),
});

const code = (Astro.params.code ?? "").toUpperCase();
if (!isValidRoomCode(code)) return Astro.redirect(`/live/join?error=notfound&lang=${locale}`);

const liveWsPort = ENV.LIVE_WS_PORT || "4322";
const httpProtocol = Astro.url.protocol === "https:" ? "https:" : "http:";
const wsProtocol = Astro.url.protocol === "https:" ? "wss:" : "ws:";
const sidecarHost = `${Astro.url.hostname}:${liveWsPort}`;

// Server-side existence pre-check (not a client-side fetch — no CORS
// involved) so an unknown/expired code shows a clean message instead of the
// browser opening a WebSocket that htmx-ext-ws would just retry forever on
// (its default reconnect-on-abnormal-closure behavior). If the sidecar
// itself isn't reachable (e.g. `bun run live` wasn't started), we fail open
// here and let the WS connection attempt surface that instead — see
// docs/ADR-live-transport.md's "what could/couldn't be verified" note.
let roomExists = true;
try {
  const res = await fetch(`${httpProtocol}//${sidecarHost}/live/${code}/exists`);
  roomExists = res.ok;
} catch {
  roomExists = true;
}

// Slice 13: purely a discoverability nicety — if this visitor happens to be
// the room's host, show a link to the dedicated big-screen view. This is
// NOT the security boundary (that's host.astro's own SSR check + the WS
// upgrade gate, see docs there); failing to reach the sidecar here just
// means the link doesn't render, nothing more.
let isHost = false;
if (roomExists) {
  try {
    const res = await fetch(`${httpProtocol}//${sidecarHost}/live/${code}/host-check`, {
      headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
    });
    if (res.ok) isHost = ((await res.json()) as { isHost: boolean }).isHost === true;
  } catch {
    isHost = false;
  }
}

const wsUrl = `${wsProtocol}//${sidecarHost}/live/${code}?lang=${locale}`;
const hostScreenUrl = `/live/${code}/host?lang=${locale}`;
---

<BaseLayout title={t("live.room.title", locale)} locale={locale}>
  {
    !roomExists ? (
      <p role="alert">{t("live.room.errorUnknownRoom", locale)}</p>
    ) : (
      <div id="live-socket" hx-ext="ws" ws-connect={wsUrl}>
        {isHost && (
          <p>
            <a href={hostScreenUrl} class="btn btn-secondary">
              {t("live.room.openHostScreen", locale)}
            </a>
          </p>
        )}
        <div id="live-room" class="stack">
          <p>{t("live.room.lobby.waiting", locale)}</p>
        </div>
      </div>
    )
  }
</BaseLayout>

<script>
  import "htmx-ext-ws";
</script>
