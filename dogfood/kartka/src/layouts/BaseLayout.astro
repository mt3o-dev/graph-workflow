---
import "../styles/global.css";
import { t, resolveLocale, type Locale } from "../i18n";
import { getCurrentUser } from "../lib/session";
import Nav from "../components/Nav.astro";

export interface Props {
  title: string;
  locale?: Locale;
}

const { title, locale: forcedLocale } = Astro.props;

const user = await getCurrentUser(Astro.cookies);
const locale: Locale =
  forcedLocale ??
  resolveLocale({
    queryLang: Astro.url.searchParams.get("lang"),
    acceptLanguage: Astro.request.headers.get("accept-language"),
  }) ??
  (user?.locale as Locale | undefined) ??
  "pl";
---

<!doctype html>
<html lang={locale} data-scheduler-preference={user?.schedulerPreference ?? "sm2"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {t("app.name", locale)}</title>
    <meta name="theme-color" content="#14b8a6" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/branding/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/branding/icon.svg" />
    <script>
      import "htmx.org";
    </script>
  </head>
  <body>
    <Nav user={user} locale={locale} />
    <main class="container">
      <div aria-live="polite" class="visually-hidden" id="a11y-announcer"></div>
      <slot />
    </main>
    <script>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js").catch(() => {
          /* offline support is a progressive enhancement, ignore failures */
        });
      }
    </script>
    {
      // Slice 6 (offline review): the sync-status indicator + reliable
      // online-event/app-load sync fallback run on every page (not just
      // /review), since a queued-offline review can be pending sync while
      // the user browses elsewhere. Logged-out visitors never queue
      // anything, so this is a harmless no-op for them.
      user && (
        <script>
          import { initSyncIndicator } from "../client/offline/sync";
          initSyncIndicator();
        </script>
      )
    }
  </body>
</html>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
