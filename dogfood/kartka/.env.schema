# Kartka environment schema (validated by varlock — see docs/ADR-varlock.md)
# @generateTsTypes(path=src/env.gen.d.ts)
# @defaultSensitive=false
# ---

# Which SQL driver to use. Slice 1 defaults to embedded sqlite; postgres is a drop-in swap.
# @required @type=enum(sqlite, postgres)
DB_DRIVER=sqlite

# Path to the sqlite database file, used when DB_DRIVER=sqlite.
# @type=string
DB_SQLITE_PATH=./data/kartka.db

# Postgres connection string, used when DB_DRIVER=postgres.
# @optional @type=string
DATABASE_URL=

# Secret used to HMAC-sign session cookies. Generate with `openssl rand -hex 32`.
# @required @sensitive @type=string(minLength=16)
SESSION_SECRET=dev-only-insecure-secret-change-me

# OpenRouter API key, wired for slice 2's LLM-assisted card generation. Not used in slice 1.
# @optional @sensitive @type=string
OPENROUTER_API_KEY=

# OpenRouter model id used for LLM-assisted card generation (slice 2). Any valid
# OpenRouter model id works; kept overridable rather than hardcoded so a cheaper
# or higher-quality model can be swapped in without a code change.
# @optional @type=string
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Port the Bun/Astro SSR server listens on.
# @type=port @example=4321
PORT=4321

# Public base URL of the site (used for absolute links, PWA manifest, etc).
# @type=url
PUBLIC_SITE_URL=http://localhost:4321

# VAPID public key for Web Push (slice 9 — due-card reminders). Sent to the
# browser as-is (it's public by design, that's the point of the VAPID
# public/private split) so the client can call pushManager.subscribe(). The
# value below is a real, generated-for-this-repo dev keypair — fine for local
# dev, but shared across every clone of this repo, so it is NOT fine for a
# real deployment. Generate your own pair before deploying for real users:
# `bunx web-push generate-vapid-keys` (or `node -e "console.log(require('web-push').generateVAPIDKeys())"`)
# — see docs/RUNNING.md for the full walkthrough.
# @required @type=string
VAPID_PUBLIC_KEY=BBVhbWu1WdquNK7gydw5rtlllXJBh5kXo18UwajHvZ3lch0MPwe9K1Hk1Ct5-Po53V7osm43EB45S1LGOylnC60

# VAPID private key, paired with VAPID_PUBLIC_KEY above. Used server-side only
# (web-push adapter signs outgoing push messages with it) — never sent to the
# client. Same "dev default, replace before real deployment" caveat as above.
# @required @sensitive @type=string
VAPID_PRIVATE_KEY=a92qytXbOutSuCC8iHbL_xzOceTkPoG9dssQQhxePwM

# Contact URL/email VAPID requires in the JWT it signs (the "subject" claim,
# `mailto:` or `https://` — push services use it to contact the sender of a
# misbehaving app). Optional in the sense that a placeholder works locally.
# @type=string
VAPID_CONTACT=mailto:admin@kartka.local

# Port the live-quiz WebSocket sidecar (slice 11, `live-server.ts`, started via
# `bun run live`) listens on. See docs/ADR-live-transport.md for why this is a
# second Bun.serve() process rather than a route inside the Astro/Bun adapter
# server, and why no reverse proxy is required for the browser to connect
# directly (cookies are host-scoped, not port-scoped).
# @type=port @example=4322
LIVE_WS_PORT=4322
