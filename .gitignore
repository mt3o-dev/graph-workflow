# Local agent/tooling state
.serena/
.claude/settings.local.json
graphify-out/

# impeccable (design skill): keep the design system + shared config; ignore local
# consent and per-session runtime state.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/live/roots.json
.impeccable/live/sessions/

# agentic-memory store: the .dump is tracked (plain text, diffs natively), the .db is
# a LOCAL BUILD ARTIFACT the store rebuilds on open. Never track the .db — a git
# clean/smudge filter cannot be auto-registered, which silently broke every fresh clone.
**/context/memory-graph.db
**/context/memory-graph.db-*
**/context/memory-graph.db.bak

# Build output (scripts/build.py)
/dist/

# Python
__pycache__/
*.py[cod]
.venv/

# Node
node_modules/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
.gw-scratch/

# impeccable live session state. `inject-journal.json` records the helper port and
# pid of a running session; the per-surface `.impeccable/live/` subtree under
# context/design/ is armed by /gw-prototype and deleted at teardown. Neither is
# knowledge and neither should ship — but the PROTOTYPES beside them are tracked
# on purpose: impeccable treats a gitignored file as generated and refuses to
# write into one, and a gitignored prototype is invisible in the PR diff.
.impeccable/live/inject-journal.json
.impeccable/live/roots.json
context/design/*/.impeccable/
